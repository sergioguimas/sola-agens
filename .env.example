# Sola Agens — copiar para .env (fora do git). Significado em specs/05 §7.
# Registro de cada sistema em agentes/*.yaml; persona/tom/respostas vêm do próprio sistema (A4, B2).
# Aqui só o motor, os fallbacks e os segredos.

AGENS_LISTEN=0.0.0.0:4100          # dentro do container; só rede Docker interna na F1 (A7)
AGENS_DATA_DIR=./data              # SQLite (A1/B1)
AGENS_AGENTES_DIR=./agentes
AGENS_TZ=America/Sao_Paulo
AGENS_LOG_DEBUG=false              # true libera argumentos de ferramenta no log — pontual, nunca contínuo

GEMINI_API_KEY=                    # plano PAGO (o gratuito pode usar o conteúdo)
AGENS_MODEL=gemini-3.6-flash       # A9 — 34/34 na avaliação de 26/10 (2.5-flash fez 10/17)
AGENS_TEMPERATURE=0
AGENS_THINKING_BUDGET=0
# US$/milhão entrada,saída. O padrão do código é o preço cheio (1.50,7.50, a partir de 01/01/2027);
# a promoção abaixo vale até 31/12/2026 — apagar a linha em janeiro.
AGENS_PRECO_GEMINI_3_6_FLASH=0.75,3.75

AGENS_SISTEMA_TIMEOUT=10s
AGENS_PAUSA_HUMANA_HORAS=12        # fallback (M1); o sistema pode sobrescrever
AGENS_RETENCAO_DIAS=90
AGENS_MANUTENCAO_HORA=4
AGENS_ENCERRAMENTO_S=30
AGENS_MAX_CONVERSAS=1000
AGENS_ADMIN_TOKEN=                 # vazio = rota de apagamento desligada (openssl rand -hex 32)

# Transcrição de áudio (copiada do Smaug)
AGENS_TRANSCRICAO=gemini           # gemini | groq
GROQ_API_KEY=

# Agente "eliza" — nomes referenciados em agentes/eliza.yaml
ELIZA_BASE_URL=http://elisa-app:3000   # container do Eliza na proxy_net (VPS da Sola)
ELIZA_ENCAMINHAMENTO_SECRET=       # = ATENDENTE_ENCAMINHAMENTO_SECRET do Eliza (openssl rand -hex 32)
ELIZA_AUTOATENDIMENTO_API_TOKEN=   # = AUTOATENDIMENTO_API_TOKEN do Eliza
