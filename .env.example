# Sola Agens — copiar para .env (fora do git). Significado em CONTRATO.md §6.
# Registro de cada sistema em agentes/*.yaml; persona/tom/respostas vêm do próprio sistema (A4, B2).
# Aqui só o motor, os fallbacks e os segredos.

AGENS_LISTEN=0.0.0.0:4100          # dentro do container; exposição decidida em A7
AGENS_DATA_DIR=./data              # base própria (A1)
AGENS_TZ=America/Sao_Paulo
AGENS_LOG_DEBUG=false              # true liga argumentos de ferramenta no log — pontual, nunca contínuo

GEMINI_API_KEY=                    # plano PAGO (o gratuito pode usar o conteúdo)
AGENS_MODEL=gemini-2.5-flash       # A2 — Flash-Lite falhou em tool calling no Smaug (29/09)
AGENS_TEMPERATURE=0
AGENS_THINKING_BUDGET=0
AGENS_MAX_ITER=8
AGENS_PAUSA_HUMANA_HORAS=12       # fallback (M1); o sistema pode sobrescrever

# Transcrição de áudio (herdado do Smaug)
AGENS_TRANSCRICAO=auto             # groq | gemini | auto
GROQ_API_KEY=

# Agente "eliza" — os nomes abaixo são referenciados em agentes/eliza.yaml
ELIZA_ENCAMINHAMENTO_SECRET=       # = ATENDENTE_ENCAMINHAMENTO_SECRET do Eliza (openssl rand -hex 32)
ELIZA_AUTOATENDIMENTO_API_TOKEN=   # = AUTOATENDIMENTO_API_TOKEN do Eliza
